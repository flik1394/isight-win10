; isightmic.inf -- install the iSight virtual microphone (PortCls WaveCyclic
; capture miniport).
;
; This is a software device: there is no hardware for PnP to find, so the
; device node has to be created on purpose.  isight-micdev.exe does that (it
; stages this INF into the driver store, creates a root-enumerated node with
; the hardware ID below and installs the driver onto it).
;
; Test-signed: the target machine needs
;     bcdedit /set testsigning on    (+ one reboot)
; and the iSightMicTest.cer that ships with the package installed into the
; machine's Root and TrustedPublisher stores.
;
; DriverVer 1.0.1.0 (2026-09-23): the driver could not start at all before this
; version.  StartDevice handed the *miniport* to PcRegisterSubdevice, which
; wants the *port*, so PortCls answered 0xC000000D and PnP marked the device
; problem 0x0a CM_PROB_FAILED_START.  The version had to move or a machine that
; already staged 1.0.0.0 would keep the old copy (SetupCopyOEMInf reports
; "already staged" for a same-version package and nothing gets replaced).
;
; DriverVer 1.0.2.0 (2026-09-24): the device started but no recording endpoint
; ever appeared.  StartDevice registered the two subdevices but never called
; PcRegisterPhysicalConnection, so KSPROPERTY_PIN_PHYSICALCONNECTION had no
; answer and AudioEndpointBuilder could not pair the wave bridge pin with the
; topology bridge pin -- no graph, no endpoint, even though every KSCATEGORY_*
; interface was registered.  Measured with isight-check/ksprobe.py: the Realtek
; wave filter answers that property with 270 bytes, every iSight pin with
; nothing.  Same reason to move the version again.
;
; DriverVer 1.0.3.0 (2026-09-24): the endpoint existed and was published but
; died the moment anything opened it -- 微信 showed "iSight Microphone" in its
; input list and closed the device again on the spot, and WASAPI answered
; AUDCLNT_E_UNSUPPORTED_FORMAT (0x88890008) to GetMixFormat, to every shared
; mode IsFormatSupported and to exclusive-mode Initialize, while the driver's
; own stream counter stayed 0.
;
; The wave filter's streaming pin was declared with Category KSCATEGORY_AUDIO
; {6994AD04-...}, which is the *render* value; a capture pin needs
; PINNAME_CAPTURE {FB6C4281-0353-11D1-905F-0000C0CC16BA}.  Both working capture
; filters on the machine that was measured (Realtek rtmicinwave and
; rtstereomixwave) use it, and the render sibling rearlineoutwave3 uses
; KSCATEGORY_AUDIO.  With the render value on a capture pin the audio engine
; never instantiated the pin at all: KSPROPERTY_PIN_GLOBALCINSTANCES stayed
; {1,0} through a whole round of open attempts, so NewStream was never reached.
; MinFilterInstanceCount on the same pin went 0 -> 1 to match those references.
; (See isight-check/ksprobe.py for the pin property dump and micdiag.py for the
; NewStream break-down.)  Version moved for the same staging reason as above.

[Version]
Signature   = "$Windows NT$"
Class       = Media
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
CatalogFile = isightmic.cat
DriverVer   = 09/24/2026,1.0.4.0

[Manufacturer]
%Provider% = IsightMic,NTamd64

[IsightMic.NTamd64]
%DeviceName% = IsightMic.Install, ISIGHTMIC\Mic

[DestinationDirs]
IsightMic.CopyFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,\

[SourceDisksFiles]
isightmic.sys = 1

; PortCls adapters must pull in the class installers for KS and WDMAUDIO.
[IsightMic.Install.NT]
Include       = ks.inf,wdmaudio.inf
Needs         = KS.Registration,WDMAUDIO.Registration
CopyFiles     = IsightMic.CopyFiles
AddReg        = IsightMic.AddReg

[IsightMic.CopyFiles]
isightmic.sys,,,0x00000002    ; COPYFLG_NODECOMP

[IsightMic.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,isightmic.sys
HKR,,NTMPDriver,,"isightmic.sys"
; Register with wdmaud.drv so the device also appears on the legacy wave/mixer
; API surface, not just as a WASAPI endpoint (the reference INF does the same).
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

; PortCls adapters are FILE_DEVICE_SOUND devices, and the device has to be
; openable by ordinary users -- a recording app is not an administrator.
[IsightMic.Install.NT.HW]
AddReg = IsightMic.HW.AddReg

[IsightMic.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[IsightMic.Install.NT.Services]
Include = ks.inf,wdmaudio.inf
Needs   = KS.Registration.Services,WDMAUDIO.Registration.Services
AddService = isightmic, 0x00000002, IsightMic.Service

[IsightMic.Service]
DisplayName   = %DeviceName%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\isightmic.sys
; No LoadOrderGroup: this is a PnP function driver, and the reference INF does
; not put audio adapters in one.

; The endpoint the user picks in WeChat / QQ / OBS comes from these interfaces.
;
; The reference string (the second column) is NOT free-form: it must be exactly
; the name the driver passes to PcRegisterSubdevice in StartDevice -- "Wave" and
; "Topology" here.  Microsoft's own sample says so in a comment at the call site
; ("make sure this name matches with <...>.szPname in the inf's [Strings]
; section"); with a mismatched name the registry values below land on an
; interface nobody registered and the endpoint comes up unnamed or not at all.
;
; The category set is the reference capture set: AUDIO + REALTIME + CAPTURE on
; the wave subdevice, AUDIO + TOPOLOGY on the topology subdevice.
[IsightMic.Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     IsightMic.I.Audio
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     IsightMic.I.Audio
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Wave%,     IsightMic.I.Audio
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, IsightMic.I.Topology
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, IsightMic.I.Topology

[IsightMic.I.Audio]
AddReg = IsightMic.I.Audio.AddReg

[IsightMic.I.Audio.AddReg]
HKR,,FriendlyName,,%DeviceName%
HKR,,CLSID,,%Proxy.CLSID%

[IsightMic.I.Topology]
AddReg = IsightMic.I.Topology.AddReg

[IsightMic.I.Topology.AddReg]
HKR,,FriendlyName,,%DeviceName% Topology
HKR,,CLSID,,%Proxy.CLSID%

[Strings]
Provider            = "iSightCam Project"
DiskName            = "iSight Virtual Microphone"
DeviceName          = "iSight Microphone (FireWire)"
Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSNAME_Wave         = "Wave"
KSNAME_Topology     = "Topology"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE  = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
